meta {
  name: Get Orders with Filters
  type: http
  seq: 1
}

get {
  url: http://localhost:8080/api/v0/merchant/1/orders?vendor_id=1&order_status=PLACED&order_status=CONFIRMED&limit=10&offset=0&ordering=total_amount
  body: none
  auth: inherit
}

params:query {
  vendor_id: 1
  order_status: PLACED
  order_status: CONFIRMED
  limit: 10
  offset: 0
  ordering: total_amount
}

headers {
  Authorization: Bearer YOUR_JWT_TOKEN
}

settings {
  encodeUrl: false
  timeout: 0
}
