meta {
  name: Update Order Status
  type: http
  seq: 2
}

put {
  url: http://localhost:8080/api/v0/merchant/1/orders/456/status
  body: json
  auth: inherit
}

headers {
  Content-Type: application/json
  Authorization: Bearer YOUR_JWT_TOKEN
}

body:json {
  {
    "status": "PLACED", // "status": "CANCELLED",  "status": "CONFIRMED"
    "remarks": "Order placed by merchant"
  }
}

settings {
  encodeUrl: false
  timeout: 0
}
