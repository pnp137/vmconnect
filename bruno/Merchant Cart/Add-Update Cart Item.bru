meta {
  name: Add/Update Cart Item
  type: http
  seq: 1
}

post {
  url: http://localhost:8080/api/v0/merchant/1/vendors/1/cart/items
  body: json
  auth: inherit
}

headers {
  Content-Type: application/json
  Authorization: Bearer YOUR_JWT_TOKEN
}

body:json {
  {
    "product_id": 123,
    "quantity": 2
  }
}

settings {
  encodeUrl: false
  timeout: 0
}
