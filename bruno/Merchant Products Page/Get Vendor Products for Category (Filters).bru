meta {
  name: Get Vendor Products for Category (Filters)
  type: http
  seq: 5
}

get {
  url: http://localhost:8080/api/v0/merchant/1/vendors/1/products/category?category_id=1&limit=10&offset=0&ordering=name&state=active
  body: none
  auth: inherit
}

params:query {
  category_id: 1
  limit: 10
  offset: 0
  ordering: name
  state: active
}

headers {
  Content-Type: application/json
}

settings {
  encodeUrl: false
  timeout: 0
}
